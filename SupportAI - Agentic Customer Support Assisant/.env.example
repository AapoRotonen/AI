# Copy to .env and set unique local values. Never use these example values in a deployed environment.
DB_URL=jdbc:postgresql://localhost:5432/supportai
DB_USERNAME=supportai
DB_PASSWORD=
JWT_SECRET=
# Leave this sentinel for offline mode, or replace it with a real project key for live chat/vector embeddings.
OPENAI_API_KEY=supportai-disabled
OPENAI_CHAT_MODEL=gpt-5.4-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
DEMO_AGENT_PASSWORD=AgentDemo123!
DEMO_SENIOR_PASSWORD=SeniorDemo123!
DEMO_OTHER_PASSWORD=OtherDemo123!
