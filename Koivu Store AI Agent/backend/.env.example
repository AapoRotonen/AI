# Copy this file to .env and add your own keys. Never commit .env.
APP_ENVIRONMENT=local
OPENAI_API_KEY=
TAVILY_API_KEY=
PROVIDER_TIMEOUT_SECONDS=30

# Comma-separated exact frontend origins; keep the local defaults for development.
CORS_ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# Local demo persistence and sessions. Use HTTPS and set COOKIE_SECURE=true in deployment.
DATABASE_PATH=./koivu.sqlite3
DATABASE_BACKEND=sqlite
SESSION_TTL_HOURS=12
COOKIE_SECURE=false

# Azure-only settings. Keep these blank for local SQLite/Chroma development.
COSMOS_ENDPOINT=
COSMOS_DATABASE_NAME=koivu
AZURE_CLIENT_ID=
CHROMA_PERSIST_DIR=./chroma_db
RAG_INDEX_BLOB_URL=

# Required to review/close support cases and to initialize the paid embedding catalog.
# Keep these server-side; do not add them to frontend code.
SUPPORT_AGENT_API_KEY=
CATALOG_SETUP_API_KEY=

# Optional hosted checkout for Stripe test mode only. Never use a live key here.
# Set PUBLIC_APP_URL to the browser-facing frontend origin (for example http://127.0.0.1:5500).
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
PUBLIC_APP_URL=
